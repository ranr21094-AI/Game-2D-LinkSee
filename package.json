{
  "name": "web-game-2d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --config vite.offline.config.mjs --configLoader runner",
    "build:sites": "tsc -b && vite build --outDir dist/client && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:watch": "vitest",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "opencc-js": "^1.4.1",
    "phaser": "3.90.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "vite-plugin-singlefile": "2.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
